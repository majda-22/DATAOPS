<?xml version="1.0" encoding="UTF-8"?>
<ivysettings>
    <!-- Resolve directly from Central, without stale local Maven metadata. -->
    <settings defaultResolver="maven-central" />
    <resolvers>
        <ibiblio name="maven-central" m2compatible="true"
                 root="https://repo.maven.apache.org/maven2/" />
    </resolvers>
</ivysettings>
